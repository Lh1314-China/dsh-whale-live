{
    "name":  "dsh-whale-live",
    "version":  "0.3.0",
    "description":  "Left-sidebar live console for DeepSeek Harness: persona script, stream log, Bilibili danmaku, edge-tts speech, optional VTube Studio/OBS/直播姬 launch helpers and a memory inbox. Windows only.",
    "type":  "module",
    "main":  "./index.js",
    "icon":  "./icon.svg",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./package.json":  "./package.json",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "lib",
                  "runtime",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg",
                  "README.md",
                  "LICENSE",
                  "CHANGELOG.md"
              ],
    "dsh":  {
                "manifestVersion":  1,
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [

                                          ]
                           },
                "compatibility":  {
                                      "dsh":  "\u003e=0.2.1-rc.2 \u003c0.4.0",
                                      "node":  "\u003e=20",
                                      "profiles":  [
                                                       "desktop",
                                                       "web"
                                                   ]
                                  }
            },
    "engines":  {
                    "node":  "\u003e=20"
                },
    "os":  [
               "win32"
           ],
    "scripts":  {
                    "check":  "node --check index.js \u0026\u0026 node --check client.js",
                    "test":  "node --test test/store.test.mjs \u0026\u0026 node test/apply.test.mjs"
                },
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "cordis-plugin",
                     "bilibili",
                     "live",
                     "persona",
                     "edge-tts",
                     "vtuber"
                 ],
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Lh1314-China/dsh-whale-live.git"
                   },
    "homepage":  "https://github.com/Lh1314-China/dsh-whale-live#readme",
    "bugs":  {
                 "url":  "https://github.com/Lh1314-China/dsh-whale-live/issues"
             },
    "author":  "Lh1314-China",
    "license":  "MIT"
}
{
  "name": "dsh-whale-live",
  "version": "0.3.3",
  "description": "A live-streaming console for DeepSeek Harness: session records, Bilibili danmaku, edge-tts speech, an avatar bridge to VTube Studio, and an opt-in memory-candidate queue. 给 DSH 的直播台：场次、弹幕、说话、皮套，以及下播后的入忆候选。",
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "runtime",
    "scripts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.5.0",
      "node": ">=20",
      "profiles": [
        "desktop",
        "web"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.5.0"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "bilibili",
    "live",
    "vtube-studio",
    "edge-tts",
    "persona"
  ],
  "author": {
    "name": "Lh1314-China",
    "url": "https://github.com/Lh1314-China"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lh1314-China/dsh-whale-live.git"
  },
  "homepage": "https://github.com/Lh1314-China/dsh-whale-live#readme",
  "bugs": {
    "url": "https://github.com/Lh1314-China/dsh-whale-live/issues"
  },
  "license": "MIT"
}
